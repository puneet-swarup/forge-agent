# Forge Agent - self-hosted / Colab adapter configuration
# Copy this file to .env and fill in your own values.
# .env is gitignored; never commit real secrets.

# --- Remote Colab / ngrok tunnel (--model=colab) ---
# OpenAI-compatible endpoint. Must be reachable from this machine.
OLLAMA_BASE_URL=https://your-tunnel.ngrok-free.dev
# Bearer token required by most Colab/ngrok endpoints. Leave empty if open.
OLLAMA_API_KEY=replace-me
# Model name passed through to the endpoint.
OLLAMA_MODEL=deepseek-r1-16k:latest

# --- Locally installed Ollama (--model=ollama) ---
# Defaults to http://localhost:11434; usually no config needed.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1:8b

# --- Proxy UI port for --model=local / --model=colab (default 1337) ---
# LOCAL_CHAT_PORT=1337
